<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8"/>
  <title>Admin • Content</title>
  <link rel="stylesheet" href="/css/admin.css"/>
  <style>
    .admin-header { display:flex; justify-content:space-between; align-items:center; margin:16px 0; }
    table { width:100%; border-collapse: collapse; }
    th, td { border-bottom:1px solid #444; padding:8px; text-align:left; }
    a.btn, button.btn { padding:6px 10px; border:1px solid #777; background:#111; color:#fff; cursor:pointer; }
    .thumb { height:48px; width:80px; object-fit:cover; }
  </style>
</head>

<body>

    <%- include('../partial/adminNavbar.ejs') %>

  <main class="admin-content">

    <div class="topSpacer"></div>

    <div class="admin-header">
      <h1>Content (Admin)</h1>
      <a class="btn" href="/admin/content/new">+ Add New</a>
    </div>

    <table class="content-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Name</th>
          <th>Type</th>
          <th>Year</th>
          <th>Genres</th>
          <th>Poster</th>
          <th>Thumbnail</th>
          <th>Video</th>
          <th>Likes</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(i => { %>
          <tr>
            <td><%= i.id %></td>
            <td><%= i.name %></td>
            <td><%= i.type %></td>
            <td><%= i.year %></td>
            <td><%= (i.genre || []).join(", ") %></td>
            <td><%= i.image ? '✔' : '' %></td>
            <td><%= i.wideimage ? '✔' : '' %></td>
            <td><%= i.trailer ? '✔' : '' %></td>
            <td><%= i.numberOfLikes ?? i.numberoflikes ?? 0 %></td>
            <td>
              <a class="btn" href="/admin/content/<%= i.id %>/edit">Edit</a>
              <form style="display:inline" method="POST" action="/admin/content/<%= i.id %>?_method=DELETE">
                <button class="btn" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</body>
</html>
