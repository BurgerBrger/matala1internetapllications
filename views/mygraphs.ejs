<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Graphs</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body>
  <%- include('partial/navbar.ejs') %>

  <main class="container" style="padding-top:80px">
    <h1 class="mb-4">My Graphs</h1>

    <div class="row g-4">
      <div class="col-12 col-lg-6">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Daily Views (last 14 days)</h5>
            <canvas id="dailyViewsChart" height="220"></canvas>
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-6">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title">Most Popular Movie Genres</h5>
            <canvas id="popularGenresChart" height="220"></canvas>
          </div>
        </div>
      </div>
    </div>
  </main>
  <script src="/js/mygraphs.js" defer></script>
</body>
</html>
