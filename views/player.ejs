<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title><%= item.name %> • Player</title>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- your global feed styles + player styles -->
  <link rel="stylesheet" href="/css/feed.css">
  <link rel="stylesheet" href="/css/player.css">
</head>
<body class="player">
  <!-- 1) NAVBAR -->
  <%- include('partial/navbar.ejs') %>

  <!-- Spacer to push content below fixed navbar (if your navbar is fixed) -->
  <div class="topSpacer"></div>

  <%
    // Precompute show/episode context BEFORE any usage below
    const isShow  = item && item.type === 'tv' && Array.isArray(item.episodes) && item.episodes.length > 0;
    const _ep     = (typeof epIndex !== 'undefined') ? Number(epIndex) : 0;  // controller may pass epIndex
    const epIdx   = Number.isFinite(_ep) ? _ep : 0;
    const safeIdx = isShow ? Math.max(0, Math.min(epIdx, item.episodes.length - 1)) : 0;
    const current = isShow ? item.episodes[safeIdx] : null;
    const src     = isShow ? (current && current.video) : ((item && (item.trailer || item.video)) || "");
  %>

  <!-- 2) HERO with wide image -->
   <!-- HERO like the feed -->
<div class="topContent">
  <!-- wide image pinned to the right -->
  <img src="<%= item.wideimage || item.image %>" class="bgImg" alt="<%= item.name %>">

  <!-- same overlay as feed -->
  <div class="topContentOverlay"></div>

  <!-- text area (we’ll put poster + info here) -->
  <div class="topContentInfo">

    <div class="player-hero-row">
      
      <img class="poster-in-hero" src="<%= item.image %>" alt="<%= item.name %> poster">

      <div class="player-hero-info">
        <h1 class="topContentTitle mb-2">
          <%= item.name %> <small class="text-secondary">(<%= item.year %>)</small>
        </h1>

        <div class="mb-3">
          <% (item.genre || []).forEach(g => { %>
            <span class="genres-pill"><%= g %></span>
          <% }) %>
        </div>

        <% if (Array.isArray(item.topActors) && item.topActors.length) { %>
          <div class="mb-2 starring">
            <strong>Starring:</strong>
            <% item.topActors.slice(0,3).forEach(function(actor){ %>
              <a
                class="actor-btn"
                href="https://en.wikipedia.org/wiki/<%= encodeURIComponent(actor.replace(/ /g, '_')) %>"
                target="_blank"
                rel="noopener noreferrer">
                <%= actor %>
              </a>
            <% }) %>
          </div>
        <% } %>

        <div class="mt-3 d-flex gap-2">
            <button id="primaryAction" class="btn btn-danger px-4">Start watching</button>
            <button id="secondaryAction" class="btn btn-secondary px-4">Start over</button>
            <a href="/feed" class="btn btn-secondary px-4">Return to feed</a>
            <button id="overviewToggle" class="btn btn-secondary px-3">Overview</button>
            <!-- Next Episode button: only shown for TV shows and when a next episode exists -->
            <% if (isShow && safeIdx < item.episodes.length - 1) { %>
              <button id="nextEpisodeBtn" class="btn btn-outline-light px-3">Next Episode ▶</button>
            <% } %>
        </div>

        <!-- Server-rendered overview container, toggled by the Overview button -->
        <div id="overviewBox" class="overview-box mt-3" style="display:none;">
          <%= item.overview ? item.overview : 'No summary available.' %>
        </div>

      </div>
    </div>
  </div>
</div>


 


<!-- 4) PLAYER + (optional) EPISODE LIST -->
<main
   id="watch"
   class="player-wrap container mt-4"
   data-isshow="<%= isShow ? 'true' : 'false' %>"
   data-content-id="<%= item.id %>"
   data-current-ep="<%= isShow ? safeIdx : 0 %>"
   data-episodes-count="<%= isShow && item.episodes ? item.episodes.length : 0 %>">
  <div class="row">
    <!-- video column -->
    <div class="<%= isShow ? 'col-lg-9' : 'col-12' %>">
      <% if (src) { %>
        <video
          id="videoEl"
          class="w-100"
          controls
          preload="metadata"
          poster="<%= item.wideimage || item.image %>">
          <source src="<%= src %>" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      <% } else { %>
        <div class="p-4 text-center">
          <p>No video available for this title.</p>
        </div>
      <% } %>
    </div>

    <% if (isShow) { %>
    <!-- episodes sidebar -->
    <aside class="col-lg-3 mt-4 mt-lg-0">
      <h5 class="mb-3">Episodes</h5>
      <div class="list-group">
        <% item.episodes.forEach((ep, i) => { %>
           <a 
             class="list-group-item list-group-item-action <%= i === safeIdx ? 'active' : '' %>"
             href="/player/<%= item.id %>?ep=<%= i %>"
             data-ep-index="<%= i %>">
             <div class="d-flex w-100 justify-content-between">
               <strong>Ep <%= ep.id %></strong>
               <% if (i === safeIdx) { %><span>Now Playing</span><% } %>
             </div>
             <small><%= ep.name %></small>
             <div class="episode-progress">
               <div class="episode-progress-inner"></div>
             </div>
           </a>
        <% }) %>
      </div>
    </aside>
    <% } %>
  </div>
</main>

  <!-- Similar content -->
  <section class="container mt-5">
    <h4 class="mb-3">Similar content</h4>

    <% if (typeof similar !== 'undefined' && similar && similar.length) { %>
      <div class="feed-row">
        <% similar.forEach(function(c) { %>
          <div class="similar-card" data-id="<%= c.id %>">
            <div class="similar-card-media">
              <a href="/player/<%= c.id %>">
                <img class="similar-card_img" src="<%= c.image %>" alt="<%= c.name %>">
              </a>

              <!-- same overlay style as feed, but without like button -->
              <div class="similar-card-overlay">
                <div class="overlay-bottom">
                  <% if (c.year) { %>
                    <span class="content-year"><%= c.year %></span>
                  <% } %>
                  <div class="content-title"><%= c.name %></div>
                  <div class="content-genres">
                    <%= (c.genre || []).join(", ") %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-muted">No similar titles yet.</p>
    <% } %>
  </section>


<script>
  // Simple Overview toggle (client-side). Uses server-rendered overview in #overviewBox.
  (function(){
    const btn = document.getElementById('overviewToggle');
    const box = document.getElementById('overviewBox');
    if (btn && box) {
      btn.addEventListener('click', () => {
        const hidden = box.style.display === 'none' || box.style.display === '';
        if (hidden) {
          box.style.display = 'block';
          btn.textContent = 'Hide overview';
        } else {
          box.style.display = 'none';
          btn.textContent = 'Overview';
        }
      });
    }
  })();
(function () {
  const videoEl = document.getElementById("videoEl");
  const root = document.getElementById("watch");
  if (!root) return;

  const isShow = root.dataset.isshow === "true";
  const contentId = Number(root.dataset.contentId || "0");
  const currentEpisodeIndex = Number(root.dataset.currentEp || "0");
  const episodesCount = Number(root.dataset.episodesCount || "0");

  // Simple direct Next Episode navigation (in addition to CTA logic). Ensures click always advances.
  const nextBtnDirect = document.getElementById('nextEpisodeBtn');
  if (nextBtnDirect) {
    nextBtnDirect.addEventListener('click', (e) => {
      e.preventDefault();
      if (currentEpisodeIndex < episodesCount - 1) {
        const target = currentEpisodeIndex + 1;
        window.location.href = `/player/${contentId}?ep=${target}`;
      }
    });
  }

  const profileId = Number(localStorage.getItem("selectedProfileId") || "0");

  const primaryBtn   = document.getElementById("primaryAction");
  const secondaryBtn = document.getElementById("secondaryAction");

  let duration = 0;
  let lastSent = 0;
  let rowsCache = []; // rows from /api/watch

  function paintEpisodeBars(rows) {
    rows.forEach(row => {
      if (!isFinite(row.position) || !isFinite(row.duration) || row.duration <= 0) return;
      const pct = Math.min(100, Math.max(0, (row.position / row.duration) * 100));
      const sel = `.list-group-item[data-ep-index="${Number(row.episodeIndex || 0)}"] .episode-progress-inner`;
      const inner = document.querySelector(sel);
      if (inner) inner.style.width = pct + "%";
    });
  }

  // compute state & actions
  function computeState() {
    if (!rowsCache.length) return { state: "fresh" };

    if (!isShow) {
      const r = rowsCache.find(r => Number(r.episodeIndex) === 0) || rowsCache[0];
      if (r && r.completed) return { state: "finished" };
      return { state: "in_progress", movieRow: r };
    }

    // show
    const lastIdx = episodesCount - 1;
    const byEp = new Map();
    rowsCache.forEach(r => byEp.set(Number(r.episodeIndex || 0), r));

    // finished if every episode has completed=true
    let allDone = episodesCount > 0;
    for (let i = 0; i < episodesCount; i++) {
      const r = byEp.get(i);
      if (!r || !r.completed) { allDone = false; break; }
    }
    if (allDone) return { state: "finished" };

    // continue: prefer the first episode that is not completed but has progress,
    // otherwise the next episode after the highest completed.
    let firstInProgress = null;
    let highestCompleted = -1;
    for (let i = 0; i < episodesCount; i++) {
      const r = byEp.get(i);
      if (r && r.completed) highestCompleted = Math.max(highestCompleted, i);
      if (!firstInProgress && r && !r.completed && r.position > 1) {
        firstInProgress = i;
      }
    }
    if (firstInProgress !== null) return { state: "in_progress", resumeEp: firstInProgress };

    const nextEp = Math.max(0, highestCompleted + 1);
    return { state: "in_progress", resumeEp: Math.min(nextEp, lastIdx) };
  }

  function applyCTA() {
    const { state, movieRow, resumeEp } = computeState();

    if (state === "fresh") {
      primaryBtn.textContent = "Start watching";
      secondaryBtn.classList.add("d-none");
      primaryBtn.onclick = () => {
        if (isShow) {
          window.location.href = `/player/${contentId}?ep=0`;
        } else if (videoEl) {
          videoEl.currentTime = 0;
          videoEl.play();
        }
      };
      return;
    }

    if (state === "in_progress") {
      primaryBtn.textContent = "Continue watching";
      secondaryBtn.textContent = "Start over";
      secondaryBtn.classList.remove("d-none");

      primaryBtn.onclick = () => {
        if (isShow) {
          const target = (typeof resumeEp === "number") ? resumeEp : 0;
          if (target !== currentEpisodeIndex) {
            window.location.href = `/player/${contentId}?ep=${target}`;
          } else if (videoEl) {
            // resume within current episode
            const row = rowsCache.find(r => Number(r.episodeIndex) === target);
            if (row && row.position > 1) videoEl.currentTime = row.position;
            videoEl.play();
          }
        } else if (videoEl) {
          const pos = movieRow && movieRow.position > 1 ? movieRow.position : 0;
          videoEl.currentTime = pos;
          videoEl.play();
        }
      };

      secondaryBtn.onclick = async () => {
        try {
          await fetch(`/api/watch/${profileId}/content/${contentId}`, { method: "DELETE" });
          // start from episode 1 / beginning
          if (isShow) window.location.href = `/player/${contentId}?ep=0`;
          else if (videoEl) { videoEl.currentTime = 0; videoEl.play(); }
        } catch (e) { console.error("clear progress failed", e); }
      };
      return;
    }

    if (state === "finished") {
      primaryBtn.textContent = "Watch again";
      secondaryBtn.classList.add("d-none");
      primaryBtn.onclick = () => {
        if (isShow) window.location.href = `/player/${contentId}?ep=0`;
        else if (videoEl) { videoEl.currentTime = 0; videoEl.play(); }
      };
    }

    // Next Episode button logic (TV only)
    const nextBtn = document.getElementById('nextEpisodeBtn');
    if (nextBtn) {
      if (isShow && currentEpisodeIndex < episodesCount - 1) {
        nextBtn.classList.remove('d-none');
        const target = currentEpisodeIndex + 1;
        nextBtn.onclick = () => {
          window.location.href = `/player/${contentId}?ep=${target}`;
        };
      } else {
        nextBtn.classList.add('d-none');
      }
    }
  }

  // --- load rows, paint bars, resume if needed, update CTAs
  if (profileId && contentId) {
    fetch(`/api/watch/${profileId}/content/${contentId}`)
      .then(r => (r.ok ? r.json() : []))
      .then(rows => {
        rowsCache = Array.isArray(rows) ? rows : [];
        paintEpisodeBars(rowsCache);

        // resume current episode/movie if we are already on its page
        if (videoEl) {
          const row = rowsCache.find(r => Number(r.episodeIndex) === currentEpisodeIndex);
          if (row && row.position > 1) videoEl.currentTime = row.position;
        }
        applyCTA();
      })
      .catch(err => { console.error("load progress failed", err); applyCTA(); });
  } else {
    applyCTA();
  }

  // --- save progress to Mongo while watching ---
  if (videoEl && profileId && contentId) {
    videoEl.addEventListener("loadedmetadata", () => { duration = videoEl.duration || 0; });

    function sendProgress(completed) {
      fetch("/api/watch", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          profileId,
          contentId,
          episodeIndex: currentEpisodeIndex,
          position: videoEl.currentTime || 0,
          duration: duration || videoEl.duration || 0,
          completed: !!completed
        })
      }).catch(e => console.error("save progress failed", e));
    }

    videoEl.addEventListener("timeupdate", () => {
      const now = videoEl.currentTime || 0;
      if (now - lastSent > 5) { lastSent = now; sendProgress(false); }
    });
    videoEl.addEventListener("pause", () => sendProgress(false));
    videoEl.addEventListener("ended", () => sendProgress(true));
  }
})();
</script>

</body>
</html>