<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <title><%= item.name %> • Player</title>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- your global feed styles + player styles -->
  <link rel="stylesheet" href="/css/feed.css">
  <link rel="stylesheet" href="/css/player.css">
</head>
<body class="player">
  <!-- 1) NAVBAR -->
  <%- include('partial/navbar.ejs') %>

  <!-- Spacer to push content below fixed navbar (if your navbar is fixed) -->
  <div class="topSpacer"></div>

  <!-- 2) HERO with wide image -->
   <!-- HERO like the feed -->
<div class="topContent">
  <!-- wide image pinned to the right -->
  <img src="<%= item.wideimage || item.image %>" class="bgImg" alt="<%= item.name %>">

  <!-- same overlay as feed -->
  <div class="topContentOverlay"></div>

  <!-- text area (we’ll put poster + info here) -->
  <div class="topContentInfo">

    <div class="player-hero-row">
      
      <img class="poster-in-hero" src="<%= item.image %>" alt="<%= item.name %> poster">

      <div class="player-hero-info">
        <h1 class="topContentTitle mb-2">
          <%= item.name %> <small class="text-secondary">(<%= item.year %>)</small>
        </h1>

        <div class="mb-3">
          <% (item.genre || []).forEach(g => { %>
            <span class="badge rounded-pill bg-dark me-1"><%= g %></span>
          <% }) %>
        </div>

        <div class="buttons">
          <a href="#watch" class="btn primary">Watch Now</a>
          <a href="/feed" class="btn secondary">Back to feed</a>
        </div>
      </div>
    </div>
  </div>
</div>

<%
  const isShow  = item && item.type === 'tv' && Array.isArray(item.episodes) && item.episodes.length > 0;
  const _ep     = (typeof epIndex !== 'undefined') ? Number(epIndex) : 0;  // controller may pass epIndex
  const epIdx   = Number.isFinite(_ep) ? _ep : 0;
  const safeIdx = isShow ? Math.max(0, Math.min(epIdx, item.episodes.length - 1)) : 0;
  const current = isShow ? item.episodes[safeIdx] : null;
  const src     = isShow ? (current && current.video) : ((item && (item.trailer || item.video)) || "");
%>


<!-- 4) PLAYER + (optional) EPISODE LIST -->
<main id="watch" class="player-wrap container mt-4">
  <div class="row">
    <!-- video column -->
    <div class="<%= isShow ? 'col-lg-9' : 'col-12' %>">
      <% if (src) { %>
        <video
          id="videoEl"
          class="w-100"
          controls
          preload="metadata"
          poster="<%= item.wideimage || item.image %>">
          <source src="<%= src %>" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      <% } else { %>
        <div class="p-4 text-center">
          <p>No video available for this title.</p>
        </div>
      <% } %>
    </div>

    <% if (isShow) { %>
    <!-- episodes sidebar -->
    <aside class="col-lg-3 mt-4 mt-lg-0">
      <h5 class="mb-3">Episodes</h5>
      <div class="list-group">
        <% item.episodes.forEach((ep, i) => { %>
          <a 
            class="list-group-item list-group-item-action <%= i === safeIdx ? 'active' : '' %>"
            href="/player/<%= item.id %>?ep=<%= i %>">
            <div class="d-flex w-100 justify-content-between">
              <strong>Ep <%= ep.id %></strong>
              <% if (i === safeIdx) { %><span>Now Playing</span><% } %>
            </div>
            <small><%= ep.name %></small>
          </a>
        <% }) %>
      </div>
    </aside>
    <% } %>
  </div>
</main>


  <script>
    const v = document.getElementById("videoEl");
    if (v) v.addEventListener("loadedmetadata", () => {
      if (v.currentTime < 0.1) v.currentTime = 0;
    });
  </script>

</body>
</html>
